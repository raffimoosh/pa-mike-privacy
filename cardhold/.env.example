# Server
PORT=3000

# Postgres (used once the Prisma store replaces the in-memory store)
DATABASE_URL=postgresql://cardhold:cardhold@localhost:5432/cardhold

# Bank data provider (Plaid-style aggregator). Leave blank to use the mock.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Money movement / holding-account partner (banking-as-a-service). Leave blank to use the mock.
BAAS_API_KEY=
