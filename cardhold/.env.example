# Server
PORT=3000

# Postgres (used once the Prisma store replaces the in-memory store)
DATABASE_URL=postgresql://cardhold:cardhold@localhost:5432/cardhold

# Stripe. Leave STRIPE_SECRET_KEY blank to run against the in-memory mocks.
# Live mode needs a restricted key with: Recipient Configuration (write),
# Money Management Financial Accounts (read), Payout Methods (write),
# Outbound Payments (write), plus PaymentIntents and Financial Connections.
STRIPE_SECRET_KEY=
# Treasury financial account (fa_...) that pools every user's held funds.
STRIPE_FINANCIAL_ACCOUNT_ID=
# Signing secret for the /webhooks/stripe endpoint.
STRIPE_WEBHOOK_SECRET=
# Text shown on the user's bank statement for debits and payouts (max 16 chars on ACH).
STRIPE_STATEMENT_DESCRIPTOR=CARDHOLD
# Version header for v2 money-management calls.
STRIPE_V2_VERSION=2026-10-28.endive
